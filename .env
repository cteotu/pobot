# Polymarket
CLOB_API_KEY=your_clob_api_key
CLOB_SECRET=your_clob_secret
CLOB_PASSPHRASE=your_clob_passphrase
WALLET_PRIVATE_KEY=your_private_key

# Hava durumu API'leri
NWS_API_BASE=https://api.weather.gov
ECMWF_API_KEY=your_ecmwf_key
OPENWEATHER_API_KEY=your_openweather_key

# Kalshi (opsiyonel)
KALSHI_API_KEY=your_kalshi_key
KALSHI_SECRET=your_kalshi_secret

# Genel
LOG_LEVEL=info
POSITION_SIZE_PCT=0.02   # base, Kelly ile override edilecek
MAX_POSITION_PCT=0.10
ARBITRAGE_THRESHOLD=0.02
